{
  "schemaVersion": 1,
  "id": "bettergrass",
  "version": "${version}",

  "name": "Better Grass",
  "description": "Makes grass better!",
  "authors": [
    "coffeelover42"
  ],

  "license": "CC0-1.0",
  "icon": "assets/bettergrass/icon.png",

  "environment": "client",
  "entrypoints": {
    "stationapi:event_bus": [
      "io.github.whoisjeb.bettergrass.InitListener"
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ],
    "gcapi3": [
      "io.github.whoisjeb.bettergrass.config.Config"
    ],
    "gcapi3:factory_provider": [
      "io.github.whoisjeb.bettergrass.config.ConfigFactories"
    ],
    "gcapi3:presave": [
      "io.github.whoisjeb.bettergrass.config.ConfigChangedListener"
    ]
  },
  "mixins": [
    "bettergrass.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
